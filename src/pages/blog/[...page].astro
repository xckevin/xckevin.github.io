---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import Pagination from '../../components/Pagination.astro';
import BlogLearningPaths from '../../components/BlogLearningPaths.astro';
import PostPreview from '../../components/PostPreview.astro';
import Subscribe from '../../components/Subscribe.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = (await getCollection('blog'))
        .filter(({ data }) => data.displayInBlog)
        .sort(sortItemsByDateDesc);
    return paginate(posts, { pageSize: siteConfig.postsPerPage || 4 });
}

type Props = { page: Page<CollectionEntry<'blog'>> };

const { page } = Astro.props;
const blog = page.data;
const locale = 'zh';
---

<BaseLayout
    title={`Android 技术文章${page.currentPage > 1 ? ` · 第 ${page.currentPage} 页` : ''}`}
    description={`系统整理 Android Framework、性能优化、Jetpack Compose、Kotlin 协程、CI/CD 与移动端工程化文章。第 ${page.currentPage} 页，共 ${page.lastPage} 页。`}
    showHeader={false}
    locale={locale}
    languageSwitchHref="/en/blog/"
    alternatePathnames={page.currentPage === 1 ? { zh: '/blog/', en: '/en/blog/', 'x-default': '/blog/' } : undefined}
>
    <h1 class="mb-12 font-serif text-2xl leading-tight italic sm:mb-16 sm:text-4xl">Android 技术文章归档</h1>
    {page.currentPage === 1 && <BlogLearningPaths locale={locale} />}
    {blog.map((post) => <PostPreview post={post} class="mb-10 sm:mb-12" locale={locale} />)}
    <Pagination page={page} class="my-16 sm:my-24" />
    <Subscribe class="my-16 sm:my-24" locale={locale} />
</BaseLayout>
