---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostPreview from '../../components/PostPreview.astro';
import Subscribe from '../../components/Subscribe.astro';
import Giscus from '../../components/Giscus.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import siteConfig from '../../data/site-config';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import { getPostHref, slugify } from '../../utils/common-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    const displayPosts = posts.filter(({ data }) => data.displayInBlog);
    return posts.map((post) => {
        const displayIndex = displayPosts.findIndex((p) => p.id === post.id);
        const inDisplay = displayIndex !== -1;
        return {
            params: { id: post.data.slug ?? post.id },
            props: {
                post,
                prevPost: inDisplay && displayIndex + 1 < displayPosts.length ? displayPosts[displayIndex + 1] : null,
                nextPost: inDisplay && displayIndex > 0 ? displayPosts[displayIndex - 1] : null
            }
        };
    });
}

type Props = { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'>; nextPost: CollectionEntry<'blog'> };

const { post, prevPost, nextPost } = Astro.props;
const canonicalPathname = post.data.seo?.canonicalPath ?? getPostHref(post, 'zh');
const canonicalHref = new URL(canonicalPathname, siteConfig.website).toString();
const href = canonicalHref;
// Hidden excerpts are noindex; full duplicate articles consolidate through canonical instead.
const noindex = post.data.seo?.noindex ?? (!post.data.displayInBlog && !post.data.seo?.canonicalPath);
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const { Content, headings } = await render(post);
const allPosts = await getCollection('blog');
const archiveTags = new Set(allPosts.filter(({ data }) => data.displayInBlog).flatMap(({ data }) => data.tags.map(slugify)));
const allEnglishPosts = await getCollection('blogEn');
const englishPost = allEnglishPosts.find((candidate) => {
    return Boolean(post.data.translationKey && candidate.data.translationKey === post.data.translationKey);
});
const locale = 'zh';
const languageSwitchHref = englishPost ? getPostHref(englishPost, 'en') : '/en/';
const alternatePathnames = englishPost && post.data.displayInBlog && !noindex && !post.data.seo?.canonicalPath && englishPost.data.displayInBlog && !englishPost.data.seo?.noindex && !englishPost.data.seo?.canonicalPath ? { zh: getPostHref(post, 'zh'), en: getPostHref(englishPost, 'en'), 'x-default': getPostHref(post, 'zh') } : undefined;
const description = seo?.description ?? excerpt;
const structuredData = [
    {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: publishDate.toISOString(),
        dateModified: (updatedDate ?? publishDate).toISOString(),
        mainEntityOfPage: {
            '@type': 'WebPage',
            '@id': canonicalHref
        },
        author: {
            '@type': 'Person',
            name: 'Kai',
            url: siteConfig.website
        },
        publisher: {
            '@type': 'Person',
            name: 'Kai',
            url: siteConfig.website
        },
        keywords: tags.join(', '),
        inLanguage: 'zh-CN'
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            {
                '@type': 'ListItem',
                position: 1,
                name: '首页',
                item: siteConfig.website
            },
            {
                '@type': 'ListItem',
                position: 2,
                name: '技术文章',
                item: new URL('/blog/', siteConfig.website).toString()
            },
            {
                '@type': 'ListItem',
                position: 3,
                name: title,
                item: canonicalHref
            }
        ]
    }
];
---

<BaseLayout
    title={seo?.title ?? title}
    description={description}
    image={seo?.image}
    pageType="article"
    canonicalPathname={canonicalPathname}
    noindex={noindex}
    publishedTime={publishDate.toISOString()}
    modifiedTime={(updatedDate ?? publishDate).toISOString()}
    showHeader={false}
    locale={locale}
    languageSwitchHref={languageSwitchHref}
    alternatePathnames={alternatePathnames}
>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <TableOfContents headings={headings} />
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
            <div class="mt-4 text-sm">
                <FormattedDate date={publishDate} />
                {
                    updatedDate && (
                        <>
                            {' '}
                            <span>
                                （更新于 <FormattedDate date={updatedDate} />）
                            </span>
                        </>
                    )
                }
            </div>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-between gap-6 text-sm sm:mt-12 sm:text-base">
            {
                tags.length > 0 && (
                    <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                        {tags.map((tag) => (
                            archiveTags.has(slugify(tag)) ? (
                                <a class="text-main hover:underline" href={`/tags/${slugify(tag)}/`}>
                                    #{tag}
                                </a>
                            ) : <span>#{tag}</span>
                        ))}
                    </div>
                )
            }
            <Button class="copy-url-button" aria-label="Copy link" data-url={href} data-tooltip-default="Copy link" data-tooltip-success="Copied">Share</Button>
        </div>
    </article>
    <RelatedPosts post={post} posts={allPosts} locale={locale} />
    {
        (prevPost || nextPost) && (
            <div class="my-16 sm:my-24">
                <h2 class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">继续阅读</h2>
                {nextPost && <PostPreview post={nextPost} class="mb-10 sm:mb-12" headingLevel="h3" locale={locale} />}
                {prevPost && <PostPreview post={prevPost} class="mb-10 sm:mb-12" headingLevel="h3" locale={locale} />}
            </div>
        )
    }
    <Giscus class="my-16 sm:my-24" />
    <Subscribe class="my-16 sm:my-24" locale={locale} />
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const copyUrlButton = document.querySelector('.copy-url-button') as HTMLButtonElement;
        copyUrlButton?.addEventListener('click', async () => {
            await copyUrl(copyUrlButton);
        });

        async function copyUrl(button: HTMLButtonElement) {
            let url = button.getAttribute('data-url') || '';
            let label = button.innerText;

            await navigator.clipboard.writeText(url);

            button.innerText = 'Copied';

            setTimeout(() => {
                button.innerText = label;
            }, 2500);
        }
    });
</script>
