---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const pages = await getCollection('pagesEn');
    return pages.map((page) => {
        return {
            params: { id: page.id },
            props: { page }
        };
    });
}

type Props = { page: CollectionEntry<'pagesEn'> };

const { page } = Astro.props;
const { title, seo } = page.data;
const { Content } = await render(page);
const locale = 'en';
const pagePath = `/en/${page.id}`;
const alternatePath = `/${page.id}`;
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description}
    image={seo?.image}
    showHeader={false}
    locale={locale}
    languageSwitchHref={alternatePath}
    alternatePathnames={{ zh: alternatePath, en: pagePath, 'x-default': alternatePath }}
>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
    </article>
</BaseLayout>
