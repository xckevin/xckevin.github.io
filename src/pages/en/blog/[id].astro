---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Button from '../../../components/Button.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Giscus from '../../../components/Giscus.astro';
import PostPreview from '../../../components/PostPreview.astro';
import RelatedPosts from '../../../components/RelatedPosts.astro';
import Subscribe from '../../../components/Subscribe.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import siteConfig from '../../../data/site-config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPostHref, slugify } from '../../../utils/common-utils';
import { sortItemsByDateDesc } from '../../../utils/data-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blogEn'))
        .filter(({ data }) => data.displayInBlog)
        .sort(sortItemsByDateDesc);
    const displayPosts = posts;
    return posts.map((post) => {
        const displayIndex = displayPosts.findIndex((p) => p.id === post.id);
        const inDisplay = displayIndex !== -1;
        return {
            params: { id: post.data.slug ?? post.id },
            props: {
                post,
                prevPost: inDisplay && displayIndex + 1 < displayPosts.length ? displayPosts[displayIndex + 1] : null,
                nextPost: inDisplay && displayIndex > 0 ? displayPosts[displayIndex - 1] : null
            }
        };
    });
}

type Props = { post: CollectionEntry<'blogEn'>; prevPost: CollectionEntry<'blogEn'> | null; nextPost: CollectionEntry<'blogEn'> | null };

const locale = 'en';
const href = new URL(`${Astro.url.pathname}${Astro.url.search}`, siteConfig.website).toString();
const canonicalHref = new URL(Astro.url.pathname, siteConfig.website).toString();
const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const { Content, headings } = await render(post);
const allPosts = await getCollection('blogEn');
const allChinesePosts = await getCollection('blog');
const chinesePost = allChinesePosts.find((candidate) => {
    return Boolean(post.data.translationKey && candidate.data.translationKey === post.data.translationKey);
});
const languageSwitchHref = chinesePost ? getPostHref(chinesePost, 'zh') : '/blog/';
const alternatePathnames = chinesePost ? { zh: getPostHref(chinesePost, 'zh'), en: getPostHref(post, 'en'), 'x-default': getPostHref(chinesePost, 'zh') } : undefined;
const description = seo?.description ?? excerpt;
const structuredData = [
    {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: seo?.title ?? title,
        description,
        datePublished: publishDate.toISOString(),
        dateModified: (updatedDate ?? publishDate).toISOString(),
        mainEntityOfPage: {
            '@type': 'WebPage',
            '@id': canonicalHref
        },
        author: {
            '@type': 'Person',
            name: 'Kai',
            url: siteConfig.website
        },
        publisher: {
            '@type': 'Person',
            name: 'Kai',
            url: siteConfig.website
        },
        keywords: tags.join(', '),
        inLanguage: 'en'
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            {
                '@type': 'ListItem',
                position: 1,
                name: 'Home',
                item: new URL('/en/', siteConfig.website).toString()
            },
            {
                '@type': 'ListItem',
                position: 2,
                name: 'Articles',
                item: new URL('/en/blog/', siteConfig.website).toString()
            },
            {
                '@type': 'ListItem',
                position: 3,
                name: title,
                item: canonicalHref
            }
        ]
    }
];
---

<BaseLayout
    title={seo?.title ?? title}
    description={description}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    locale={locale}
    languageSwitchHref={languageSwitchHref}
    alternatePathnames={alternatePathnames}
>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <TableOfContents headings={headings} />
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
            <div class="mt-4 text-sm">
                <FormattedDate date={publishDate} />
                {
                    updatedDate && (
                        <>
                            {' '}
                            <span>
                                (Updated on <FormattedDate date={updatedDate} />)
                            </span>
                        </>
                    )
                }
            </div>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-between gap-6 text-sm sm:mt-12 sm:text-base">
            {
                tags.length > 0 && (
                    <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                        {tags.map((tag) => (
                            <a class="text-main hover:underline" href={`/en/tags/${slugify(tag)}`}>
                                #{tag}
                            </a>
                        ))}
                    </div>
                )
            }
            <Button class="copy-url-button" aria-label="Copy link" data-url={href} data-tooltip-default="Copy link" data-tooltip-success="Copied">Share</Button>
        </div>
    </article>
    <RelatedPosts post={post} posts={allPosts} locale={locale} />
    {
        (prevPost || nextPost) && (
            <div class="my-16 sm:my-24">
                <h2 class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">Read Next</h2>
                {nextPost && <PostPreview post={nextPost} class="mb-10 sm:mb-12" headingLevel="h3" locale={locale} />}
                {prevPost && <PostPreview post={prevPost} class="mb-10 sm:mb-12" headingLevel="h3" locale={locale} />}
            </div>
        )
    }
    <Giscus class="my-16 sm:my-24" />
    <Subscribe class="my-16 sm:my-24" locale={locale} />
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const copyUrlButton = document.querySelector('.copy-url-button') as HTMLButtonElement;
        copyUrlButton?.addEventListener('click', async () => {
            await copyUrl(copyUrlButton);
        });

        async function copyUrl(button: HTMLButtonElement) {
            let url = button.getAttribute('data-url') || '';
            let label = button.innerText;

            await navigator.clipboard.writeText(url);

            button.innerText = 'Copied';

            setTimeout(() => {
                button.innerText = label;
            }, 2500);
        }
    });
</script>
